ADMIN_PORT=8092
# 관리자 비밀번호는 첫 접속 화면에서 만듭니다. ADMIN_PASSWORD는 사용하지 않습니다.
# 텔레그램 토큰과 가계부 앱 비밀번호는 서비스 설정 화면에서 입력하세요.
# CLI 모드에만 사용. 화면에서 선택한 제공자와 같게 지정합니다. 모델은 화면에서 설정합니다.
AI_PROVIDER=codex
AI_TIMEOUT=180
# 선택한 CLI의 설치 버전을 명시하세요 (docs/ai-providers.md 참고).
CODEX_VERSION=
CLAUDE_VERSION=
AGY_VERSION=

# CLI runner 전용 인증 토큰 생성 방법은 docs/ai-providers.md 참고
AI_RUNNER_TOKEN=
BRIDGE_MEMORY_LIMIT=2g

# 버전을 고정하려면 latest 대신 원하는 릴리즈 버전을 지정하세요.
RECEIPT_BRIDGE_IMAGE=ghcr.io/daytivehq/receipt-bridge:latest
